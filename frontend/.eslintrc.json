{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "off",
    "no-empty": "warn",
    "no-case-declarations": "warn",
    "no-useless-catch": "warn"
  },
  "ignorePatterns": ["build/", "node_modules/", "public/"]
}
