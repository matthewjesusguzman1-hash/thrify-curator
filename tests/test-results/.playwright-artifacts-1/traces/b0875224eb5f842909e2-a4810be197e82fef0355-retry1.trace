; justify-content: space-between; align-items: center; }\n@supports (padding-top: env(safe-area-inset-top)) {\n  .dashboard-header { padding-top: calc(env(safe-area-inset-top, 0px) + 1rem); }\n}\n.dashboard-content { padding: 1.5rem; max-width: 1200px; margin: 0px auto; }\n.dashboard-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }\n@media (min-width: 768px) {\n  .dashboard-grid { grid-template-columns: repeat(2, 1fr); }\n}\n@media (min-width: 1024px) {\n  .dashboard-grid { grid-template-columns: repeat(3, 1fr); }\n}\n.clock-btn { width: 100%; padding: 1.5rem; border-radius: 1rem; font-size: 1.25rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; transition: transform 0.2s, box-shadow 0.3s; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; }\n.clock-btn:hover { transform: translateY(-3px); }\n.clock-btn-in { background: linear-gradient(135deg, rgb(139, 168, 142) 0%, rgb(107, 155, 110) 100%); color: white; box-shadow: rgba(139, 168, 142, 0.4) 0px 4px 15px; }\n.clock-btn-in:hover { box-shadow: rgba(139, 168, 142, 0.5) 0px 8px 25px; }\n.clock-btn-out { background: linear-gradient(135deg, rgb(212, 140, 158) 0%, rgb(197, 122, 140) 100%); color: white; box-shadow: rgba(212, 140, 158, 0.4) 0px 4px 15px; }\n.clock-btn-out:hover { box-shadow: rgba(212, 140, 158, 0.5) 0px 8px 25px; }\n.status-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 600; }\n.status-badge-active { background: rgba(139, 168, 142, 0.15); color: rgb(90, 138, 94); }\n.status-badge-inactive { background: rgba(212, 140, 158, 0.15); color: rgb(181, 103, 122); }\n.auth-container { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; background-color: rgb(255, 250, 250); }\n.auth-card { width: 100%; max-width: 24rem; background: white; border-radius: 1.5rem; padding: 2.5rem; box-shadow